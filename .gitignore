*.pyc
.venv/
venv/
.claudex/
AGENTS.md

# Zoo Design Studio auto-scaffolds these into any folder it opens as a
# project -- not part of what ZooMounter itself generates, so keep them
# out of version control wherever they show up.
project.toml
thumbnail.png
main.kcl

# ...except under probes/, where the generated KCL *is* the evidence. Section 8
# of NOTES-FOR-ZOO.md is a claim about what the Agent API emits, so the files
# backing that claim have to be in the repo.
!probes/**/main.kcl

# Raw run log is just the polling transcript; probe_results.json has the data.
probes/probe_run.log
.pytest_cache/
.vscode/
*.egg-info/
build/
dist/
