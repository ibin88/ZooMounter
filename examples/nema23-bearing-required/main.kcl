/*
Generated by Text-to-CAD:
Define these named parameters at the top of the file, using exactly these names. Where an expression is given, write the expression -- do not replace it with a pre-computed number:

  plateThickness   = 7mm
  plateHeight      = 56.4mm
  boltHoleDia      = 5.5mm
  boltSpacing      = 47.14mm
  boltHoleOffset   = boltSpacing / 2
  slotSpacing      = 80mm
  slotLength       = 15mm
  slotWidth        = 5.5mm
  edgeMargin       = 10mm
  slotCenterOffset = slotSpacing / 2
  plateWidth       = slotSpacing + 2 * edgeMargin
  bearingSeatDia   = 22mm

Then build the part from those parameters, referring to them by name rather than repeating their values:

A flat rectangular mounting plate, plateWidth wide (x-axis) by plateHeight tall (y-axis) by plateThickness thick, centered at the origin.
It has 4 through-holes of boltHoleDia diameter, centered at (-boltHoleOffset, -boltHoleOffset), (boltHoleOffset, -boltHoleOffset), (boltHoleOffset, boltHoleOffset) and (-boltHoleOffset, boltHoleOffset).
It also has 2 adjustment slots cut through the full thickness, each slotLength long along the y-axis and slotWidth wide with semicircular ends, centered at (-slotCenterOffset, 0) and (slotCenterOffset, 0).
It has a through-hole of bearingSeatDia diameter centered on the plate, sized to seat a 608 bearing.
All holes and slots go through the full thickness of the plate.
*/
@settings(kclVersion = 2.0, defaultLengthUnit = mm)

plateThickness = 7mm
plateHeight = 56.4mm
boltHoleDia = 5.5mm
boltSpacing = 47.14mm
boltHoleOffset = boltSpacing / 2
slotSpacing = 80mm
slotLength = 15mm
slotWidth = 5.5mm
edgeMargin = 10mm
slotCenterOffset = slotSpacing / 2
plateWidth = slotSpacing + 2 * edgeMargin
bearingSeatDia = 22mm

slotRadius = slotWidth / 2
slotStraightLength = slotLength - slotWidth
cutDepth = plateThickness + 2mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -50mm, var -28.2mm], end = [var 50mm, var -28.2mm])
  rightEdge = line(start = [var 50mm, var -28.2mm], end = [var 50mm, var 28.2mm])
  topEdge = line(start = [var 50mm, var 28.2mm], end = [var -50mm, var 28.2mm])
  leftEdge = line(start = [var -50mm, var 28.2mm], end = [var -50mm, var -28.2mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateWidth
  distance([rightEdge.start, rightEdge.end]) == plateHeight
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateHeight / 2
}

plateRegion = region(
  segments = [
    plateSketch.bottomEdge,
    plateSketch.rightEdge
  ],
  intersectionIndex = -1,
  direction = CCW,
)
plateBlank = extrude(plateRegion, length = plateThickness, symmetric = true)

bearingSketch = sketch(on = XY) {
  bearingCircle = circle(start = [var 11mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([bearingCircle.center, ORIGIN])
  horizontal([
    bearingCircle.center,
    bearingCircle.start
  ])
  diameter(bearingCircle) == bearingSeatDia
}

bearingRegion = region(segments = [bearingSketch.bearingCircle])
bearingCutter = extrude(
  bearingRegion,
  length = cutDepth,
  symmetric = true,
  method = NEW,
)
plateWithBearingSeat = subtract(plateBlank, tools = [bearingCutter])

boltHoleSketch = sketch(on = XY) {
  boltHoleCircle = circle(start = [var -20.82mm, var -23.57mm], center = [var -23.57mm, var -23.57mm])

  horizontal([
    boltHoleCircle.center,
    boltHoleCircle.start
  ])
  horizontalDistance([boltHoleCircle.center, ORIGIN]) == boltHoleOffset
  verticalDistance([boltHoleCircle.center, ORIGIN]) == boltHoleOffset
  diameter(boltHoleCircle) == boltHoleDia
}

boltHoleRegion = region(segments = [boltHoleSketch.boltHoleCircle])
boltHoleSeedCutter = extrude(
  boltHoleRegion,
  length = cutDepth,
  symmetric = true,
  method = NEW,
)
boltHoleCutters = patternLinear3d(
  patternLinear3d(
    boltHoleSeedCutter,
    instances = 2,
    distance = boltSpacing,
    axis = X,
  ),
  instances = 2,
  distance = boltSpacing,
  axis = Y,
)
plateWithBoltHoles = subtract(plateWithBearingSeat, tools = boltHoleCutters)

slotBarSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -42.75mm, var -4.75mm], end = [var -37.25mm, var -4.75mm])
  rightEdge = line(start = [var -37.25mm, var -4.75mm], end = [var -37.25mm, var 4.75mm])
  topEdge = line(start = [var -37.25mm, var 4.75mm], end = [var -42.75mm, var 4.75mm])
  leftEdge = line(start = [var -42.75mm, var 4.75mm], end = [var -42.75mm, var -4.75mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == slotWidth
  distance([rightEdge.start, rightEdge.end]) == slotStraightLength
  horizontalDistance([bottomEdge.start, ORIGIN]) == slotCenterOffset + slotRadius
  verticalDistance([bottomEdge.start, ORIGIN]) == slotStraightLength / 2
}

slotBarRegion = region(
  segments = [
    slotBarSketch.bottomEdge,
    slotBarSketch.rightEdge
  ],
  intersectionIndex = -1,
  direction = CCW,
)
slotBarSeedCutter = extrude(
  slotBarRegion,
  length = cutDepth,
  symmetric = true,
  method = NEW,
)
slotBarCutters = patternLinear3d(
  slotBarSeedCutter,
  instances = 2,
  distance = slotSpacing,
  axis = X,
)
plateWithSlotBars = subtract(plateWithBoltHoles, tools = slotBarCutters)

slotEndSketch = sketch(on = XY) {
  slotEndCircle = circle(start = [var -37.25mm, var -4.75mm], center = [var -40mm, var -4.75mm])

  horizontal([
    slotEndCircle.center,
    slotEndCircle.start
  ])
  horizontalDistance([slotEndCircle.center, ORIGIN]) == slotCenterOffset
  verticalDistance([slotEndCircle.center, ORIGIN]) == slotStraightLength / 2
  diameter(slotEndCircle) == slotWidth
}

slotEndRegion = region(segments = [slotEndSketch.slotEndCircle])
slotEndSeedCutter = extrude(
  slotEndRegion,
  length = cutDepth,
  symmetric = true,
  method = NEW,
)
slotEndCutters = patternLinear3d(
  patternLinear3d(
    slotEndSeedCutter,
    instances = 2,
    distance = slotStraightLength,
    axis = Y,
  ),
  instances = 2,
  distance = slotSpacing,
  axis = X,
)
plateCut = subtract(plateWithSlotBars, tools = slotEndCutters)

hide(plateSketch)
hide(bearingSketch)
hide(boltHoleSketch)
hide(slotBarSketch)
hide(slotEndSketch)

finishedPlate = appearance(
  plateCut,
  color = "#aeb6bf",
  metalness = 72,
  roughness = 30,
)
