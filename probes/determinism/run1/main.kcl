/*
Generated by Text-to-CAD:
Define these named parameters at the top of the file, using exactly these names. Where an expression is given, write the expression -- do not replace it with a pre-computed number:

  plateThickness   = 7mm
  plateHeight      = 56.4mm
  boltHoleDia      = 5.5mm
  boltSpacing      = 47.14mm
  boltHoleOffset   = boltSpacing / 2
  centerHoleDia    = 38.1mm
  slotSpacing      = 80mm
  slotLength       = 15mm
  slotWidth        = 5.5mm
  edgeMargin       = 10mm
  slotCenterOffset = slotSpacing / 2
  plateWidth       = slotSpacing + 2 * edgeMargin

Then build the part from those parameters, referring to them by name rather than repeating their values:

A flat rectangular mounting plate, plateWidth wide (x-axis) by plateHeight tall (y-axis) by plateThickness thick, centered at the origin.
It has 4 through-holes of boltHoleDia diameter, centered at (-boltHoleOffset, -boltHoleOffset), (boltHoleOffset, -boltHoleOffset), (boltHoleOffset, boltHoleOffset) and (-boltHoleOffset, boltHoleOffset).
It also has a through-hole of centerHoleDia diameter centered on the plate.
It also has 2 adjustment slots cut through the full thickness, each slotLength long along the y-axis and slotWidth wide with semicircular ends, centered at (-slotCenterOffset, 0) and (slotCenterOffset, 0).
All holes and slots go through the full thickness of the plate.
*/
@settings(kclVersion = 2.0, defaultLengthUnit = mm)

plateThickness = 7mm
plateHeight = 56.4mm
boltHoleDia = 5.5mm
boltSpacing = 47.14mm
boltHoleOffset = boltSpacing / 2
centerHoleDia = 38.1mm
slotSpacing = 80mm
slotLength = 15mm
slotWidth = 5.5mm
edgeMargin = 10mm
slotCenterOffset = slotSpacing / 2
plateWidth = slotSpacing + 2 * edgeMargin

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -50mm, var -28.2mm], end = [var 50mm, var -28.2mm])
  rightEdge = line(start = [var 50mm, var -28.2mm], end = [var 50mm, var 28.2mm])
  topEdge = line(start = [var 50mm, var 28.2mm], end = [var -50mm, var 28.2mm])
  leftEdge = line(start = [var -50mm, var 28.2mm], end = [var -50mm, var -28.2mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateWidth
  distance([rightEdge.start, rightEdge.end]) == plateHeight
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateHeight / 2
}

plateRegion = region(
  segments = [
    plateSketch.bottomEdge,
    plateSketch.rightEdge
  ],
  intersectionIndex = -1,
  direction = CCW,
)
plateBlank = extrude(plateRegion, length = plateThickness, symmetric = true)
hiddenPlateSketch = hide(plateSketch)

boltHoleSketch = sketch(on = XY) {
  boltCircle = circle(start = [var -20.82mm, var -23.57mm], center = [var -23.57mm, var -23.57mm])

  horizontal([boltCircle.center, boltCircle.start])
  horizontalDistance([boltCircle.center, ORIGIN]) == boltHoleOffset
  verticalDistance([boltCircle.center, ORIGIN]) == boltHoleOffset
  diameter(boltCircle) == boltHoleDia
}

boltHoleRegion = region(segments = [boltHoleSketch.boltCircle])
boltHoleSeed = extrude(
  boltHoleRegion,
  length = plateThickness * 2,
  symmetric = true,
  method = NEW,
)
boltHoleRow = patternLinear3d(
  boltHoleSeed,
  instances = 2,
  distance = boltSpacing,
  axis = X,
)
boltHoleCutters = patternLinear3d(
  boltHoleRow,
  instances = 2,
  distance = boltSpacing,
  axis = Y,
)
plateWithBoltHoles = subtract(plateBlank, tools = boltHoleCutters)
hiddenBoltHoleSketch = hide(boltHoleSketch)

centerHoleSketch = sketch(on = XY) {
  centerCircle = circle(start = [var 19.05mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([centerCircle.center, ORIGIN])
  horizontal([
    centerCircle.center,
    centerCircle.start
  ])
  diameter(centerCircle) == centerHoleDia
}

centerHoleRegion = region(segments = [centerHoleSketch.centerCircle])
centerHoleCutter = extrude(
  centerHoleRegion,
  length = plateThickness * 2,
  symmetric = true,
  method = NEW,
)
plateWithCenterHole = subtract(plateWithBoltHoles, tools = [centerHoleCutter])
hiddenCenterHoleSketch = hide(centerHoleSketch)

slotSketch = sketch(on = XY) {
  rightEdge = line(start = [var -37.25mm, var -4.75mm], end = [var -37.25mm, var 4.75mm])
  topArc = arc(start = [var -37.25mm, var 4.75mm], end = [var -42.75mm, var 4.75mm], center = [var -40mm, var 4.75mm])
  leftEdge = line(start = [var -42.75mm, var 4.75mm], end = [var -42.75mm, var -4.75mm])
  bottomArc = arc(start = [var -42.75mm, var -4.75mm], end = [var -37.25mm, var -4.75mm], center = [var -40mm, var -4.75mm])
  centerGuide = line(start = [var -40mm, var -4.75mm], end = [var -40mm, var 4.75mm], construction = true)

  coincident([rightEdge.end, topArc.start])
  coincident([topArc.end, leftEdge.start])
  coincident([leftEdge.end, bottomArc.start])
  coincident([bottomArc.end, rightEdge.start])
  coincident([centerGuide.start, bottomArc.center])
  coincident([centerGuide.end, topArc.center])
  horizontal([topArc.center, topArc.start])
  horizontal([topArc.center, topArc.end])
  horizontal([bottomArc.center, bottomArc.start])
  horizontal([bottomArc.center, bottomArc.end])
  vertical(centerGuide)
  distance([centerGuide.start, centerGuide.end]) == slotLength - slotWidth
  radius(topArc) == slotWidth / 2
  radius(bottomArc) == slotWidth / 2
  horizontalDistance([topArc.center, ORIGIN]) == slotCenterOffset
  verticalDistance([ORIGIN, topArc.center]) == (slotLength - slotWidth) / 2
}

slotRegion = region(
  segments = [
    slotSketch.rightEdge,
    slotSketch.topArc
  ],
  intersectionIndex = -1,
  direction = CCW,
)
slotSeed = extrude(
  slotRegion,
  length = plateThickness * 2,
  symmetric = true,
  method = NEW,
)
slotCutters = patternLinear3d(
  slotSeed,
  instances = 2,
  distance = slotSpacing,
  axis = X,
)
finishedPlate = subtract(plateWithCenterHole, tools = slotCutters)
hiddenSlotSketch = hide(slotSketch)
