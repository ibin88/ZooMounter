/*
Generated by Text-to-CAD:
Define these named parameters at the top of the file, using exactly these names. Where an expression is given, write the expression -- do not replace it with a pre-computed number:

  plateThickness   = 11mm
  plateHeight      = 44mm
  boltHoleDia      = 3.4mm
  centerHoleDia    = 13mm
  plateWidth       = 44mm
  bearingSeatDia   = 26mm
  bearingSeatDepth = 9mm

Then build the part from those parameters, referring to them by name rather than repeating their values:

A flat rectangular mounting plate, plateWidth wide (x-axis) by plateHeight tall (y-axis) by plateThickness thick, centered at the origin.
It has 4 through-holes of boltHoleDia diameter, centered at these (x, y) coordinates relative to the plate center: (19mm, 0mm); (0mm, 19mm); (-19mm, 0mm); (-0mm, -19mm).
It also has a through-hole of centerHoleDia diameter centered on the plate.
It has a counterbore of bearingSeatDia diameter and bearingSeatDepth depth, centered on the plate and opening from the top face, to seat a 51101 thrust bearing. The counterbore is blind -- it does not go through the plate.
All holes go through the full thickness of the plate, except the counterbore, which is blind to its stated depth.
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateThickness = 11mm
plateHeight = 44mm
boltHoleDia = 3.4mm
centerHoleDia = 13mm
plateWidth = 44mm
bearingSeatDia = 26mm
bearingSeatDepth = 9mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -1mm, var -1mm], end = [var 1mm, var -1mm])
  rightEdge = line(start = [var 1mm, var -1mm], end = [var 1mm, var 1mm])
  topEdge = line(start = [var 1mm, var 1mm], end = [var -1mm, var 1mm])
  leftEdge = line(start = [var -1mm, var 1mm], end = [var -1mm, var -1mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateWidth
  distance([rightEdge.start, rightEdge.end]) == plateHeight
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateHeight / 2
}
plateRegion = region(
  segments = [
    plateSketch.bottomEdge,
    plateSketch.rightEdge
  ],
  intersectionIndex = -1,
  direction = CCW,
)
plateBlank = extrude(plateRegion, length = plateThickness, symmetric = true)
hide(plateSketch)

boltHoleSketch = sketch(on = XY) {
  rightHole = circle(start = [var 20mm, var 0mm], center = [var 19mm, var 0mm])
  topHole = circle(start = [var 1mm, var 19mm], center = [var 0mm, var 19mm])
  leftHole = circle(start = [var -18mm, var 0mm], center = [var -19mm, var 0mm])
  bottomHole = circle(start = [var 1mm, var -19mm], center = [var 0mm, var -19mm])

  horizontal([rightHole.center, rightHole.start])
  horizontalDistance([ORIGIN, rightHole.center]) == 19mm
  verticalDistance([ORIGIN, rightHole.center]) == 0mm
  diameter(rightHole) == boltHoleDia

  horizontal([topHole.center, topHole.start])
  horizontalDistance([ORIGIN, topHole.center]) == 0mm
  verticalDistance([ORIGIN, topHole.center]) == 19mm
  diameter(topHole) == boltHoleDia

  horizontal([leftHole.center, leftHole.start])
  horizontalDistance([leftHole.center, ORIGIN]) == 19mm
  verticalDistance([ORIGIN, leftHole.center]) == 0mm
  diameter(leftHole) == boltHoleDia

  horizontal([bottomHole.center, bottomHole.start])
  horizontalDistance([ORIGIN, bottomHole.center]) == 0mm
  verticalDistance([bottomHole.center, ORIGIN]) == 19mm
  diameter(bottomHole) == boltHoleDia
}
rightHoleCutter = extrude(region(segments = [boltHoleSketch.rightHole]), length = plateThickness * 2, symmetric = true)
topHoleCutter = extrude(region(segments = [boltHoleSketch.topHole]), length = plateThickness * 2, symmetric = true)
leftHoleCutter = extrude(region(segments = [boltHoleSketch.leftHole]), length = plateThickness * 2, symmetric = true)
bottomHoleCutter = extrude(region(segments = [boltHoleSketch.bottomHole]), length = plateThickness * 2, symmetric = true)
plateWithBoltHoles = subtract(
  plateBlank,
  tools = [
    rightHoleCutter,
    topHoleCutter,
    leftHoleCutter,
    bottomHoleCutter
  ],
)
hide(boltHoleSketch)

steppedCutterSketch = sketch(on = XZ) {
  bottomEdge = line(start = [var 0mm, var -11mm], end = [var 6.5mm, var -11mm])
  centerWall = line(start = [var 6.5mm, var -11mm], end = [var 6.5mm, var -3.5mm])
  seatFloor = line(start = [var 6.5mm, var -3.5mm], end = [var 13mm, var -3.5mm])
  seatWall = line(start = [var 13mm, var -3.5mm], end = [var 13mm, var 11mm])
  topEdge = line(start = [var 13mm, var 11mm], end = [var 0mm, var 11mm])
  axisEdge = line(start = [var 0mm, var 11mm], end = [var 0mm, var -11mm])

  coincident([bottomEdge.end, centerWall.start])
  coincident([centerWall.end, seatFloor.start])
  coincident([seatFloor.end, seatWall.start])
  coincident([seatWall.end, topEdge.start])
  coincident([topEdge.end, axisEdge.start])
  coincident([axisEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(centerWall)
  horizontal(seatFloor)
  vertical(seatWall)
  horizontal(topEdge)
  vertical(axisEdge)
  vertical([bottomEdge.start, ORIGIN])
  verticalDistance([bottomEdge.start, ORIGIN]) == plateThickness
  verticalDistance([ORIGIN, topEdge.end]) == plateThickness
  horizontalDistance([bottomEdge.start, bottomEdge.end]) == centerHoleDia / 2
  horizontalDistance([bottomEdge.start, seatWall.start]) == bearingSeatDia / 2
  verticalDistance([ORIGIN, seatFloor.start]) == plateThickness / 2 - bearingSeatDepth
}
steppedCutterRegion = region(
  segments = [
    steppedCutterSketch.bottomEdge,
    steppedCutterSketch.centerWall
  ],
  intersectionIndex = -1,
  direction = CCW,
)
steppedCenterCutter = revolve(steppedCutterRegion, axis = Y)
plateFinished = subtract(plateWithBoltHoles, tools = [steppedCenterCutter])
hide(steppedCutterSketch)

mountingPlate = appearance(
  plateFinished,
  color = "#aeb7c2",
  metalness = 75,
  roughness = 32,
)
