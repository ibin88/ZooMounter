/*
Generated by Text-to-CAD:
Define these named parameters at the top of the file, using exactly these names. Where an expression is given, write the expression -- do not replace it with a pre-computed number:

  plateThickness   = 1mm
  plateHeight      = 42.3mm
  boltHoleDia      = 3.4mm
  boltSpacing      = 31mm
  boltHoleOffset   = boltSpacing / 2
  centerHoleDia    = 22mm
  slotSpacing      = 80mm
  slotLength       = 20mm
  slotWidth        = 9mm
  edgeMargin       = 15mm
  slotCenterOffset = slotSpacing / 2
  plateWidth       = slotSpacing + 2 * edgeMargin

Then build the part from those parameters, referring to them by name rather than repeating their values:

A flat rectangular mounting plate, plateWidth wide (x-axis) by plateHeight tall (y-axis) by plateThickness thick, centered at the origin.
It has 4 through-holes of boltHoleDia diameter, centered at (-boltHoleOffset, -boltHoleOffset), (boltHoleOffset, -boltHoleOffset), (boltHoleOffset, boltHoleOffset) and (-boltHoleOffset, boltHoleOffset).
It also has a through-hole of centerHoleDia diameter centered on the plate.
It also has 2 adjustment slots cut through the full thickness, each slotLength long along the y-axis and slotWidth wide with semicircular ends, centered at (-slotCenterOffset, 0) and (slotCenterOffset, 0).
All holes and slots go through the full thickness of the plate.
*/
@settings(kclVersion = 2.0, defaultLengthUnit = mm)

plateThickness = 1mm
plateHeight = 42.3mm
boltHoleDia = 3.4mm
boltSpacing = 31mm
boltHoleOffset = boltSpacing / 2
centerHoleDia = 22mm
slotSpacing = 80mm
slotLength = 20mm
slotWidth = 9mm
edgeMargin = 15mm
slotCenterOffset = slotSpacing / 2
plateWidth = slotSpacing + 2 * edgeMargin

throughCutDepth = 3 * plateThickness
slotStraightLength = slotLength - slotWidth

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -55mm, var -21.15mm], end = [var 55mm, var -21.15mm])
  rightEdge = line(start = [var 55mm, var -21.15mm], end = [var 55mm, var 21.15mm])
  topEdge = line(start = [var 55mm, var 21.15mm], end = [var -55mm, var 21.15mm])
  leftEdge = line(start = [var -55mm, var 21.15mm], end = [var -55mm, var -21.15mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateWidth
  distance([rightEdge.start, rightEdge.end]) == plateHeight
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateHeight / 2
}

plateRegion = region(
  segments = [
    plateSketch.bottomEdge,
    plateSketch.rightEdge
  ],
  intersectionIndex = -1,
  direction = CCW,
)
plateBlank = extrude(plateRegion, length = plateThickness, symmetric = true)
hide(plateSketch)

centerHoleSketch = sketch(on = XY) {
  centerHoleCircle = circle(start = [var 11mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([centerHoleCircle.center, ORIGIN])
  horizontal([
    centerHoleCircle.center,
    centerHoleCircle.start
  ])
  diameter(centerHoleCircle) == centerHoleDia
}

centerHoleRegion = region(segments = [centerHoleSketch.centerHoleCircle])
centerHoleCutter = extrude(
  centerHoleRegion,
  length = throughCutDepth,
  symmetric = true,
  method = NEW,
)
plateWithCenterHole = subtract(plateBlank, tools = [centerHoleCutter])
hide(centerHoleSketch)

boltHoleSketch = sketch(on = XY) {
  boltHoleCircle = circle(start = [var -13.8mm, var -15.5mm], center = [var -15.5mm, var -15.5mm])

  horizontal([
    boltHoleCircle.center,
    boltHoleCircle.start
  ])
  horizontalDistance([boltHoleCircle.center, ORIGIN]) == boltHoleOffset
  verticalDistance([boltHoleCircle.center, ORIGIN]) == boltHoleOffset
  diameter(boltHoleCircle) == boltHoleDia
}

boltHoleRegion = region(segments = [boltHoleSketch.boltHoleCircle])
boltHoleSeedCutter = extrude(
  boltHoleRegion,
  length = throughCutDepth,
  symmetric = true,
  method = NEW,
)
boltHoleCutters = patternLinear3d(
  patternLinear3d(
    boltHoleSeedCutter,
    instances = 2,
    distance = boltSpacing,
    axis = X,
  ),
  instances = 2,
  distance = boltSpacing,
  axis = Y,
)
plateWithBoltHoles = subtract(plateWithCenterHole, tools = boltHoleCutters)
hide(boltHoleSketch)

slotSketch = sketch(on = XY) {
  leftEdge = line(start = [var -44.5mm, var 5.5mm], end = [var -44.5mm, var -5.5mm])
  bottomArc = arc(start = [var -44.5mm, var -5.5mm], end = [var -35.5mm, var -5.5mm], center = [var -40mm, var -5.5mm])
  rightEdge = line(start = [var -35.5mm, var -5.5mm], end = [var -35.5mm, var 5.5mm])
  topArc = arc(start = [var -35.5mm, var 5.5mm], end = [var -44.5mm, var 5.5mm], center = [var -40mm, var 5.5mm])

  coincident([leftEdge.end, bottomArc.start])
  coincident([bottomArc.end, rightEdge.start])
  coincident([rightEdge.end, topArc.start])
  coincident([topArc.end, leftEdge.start])
  vertical(leftEdge)
  vertical(rightEdge)
  horizontal([bottomArc.center, bottomArc.start])
  horizontal([bottomArc.center, bottomArc.end])
  horizontal([topArc.center, topArc.start])
  horizontal([topArc.center, topArc.end])
  radius(bottomArc) == slotWidth / 2
  radius(topArc) == slotWidth / 2
  horizontalDistance([bottomArc.center, ORIGIN]) == slotCenterOffset
  verticalDistance([bottomArc.center, ORIGIN]) == slotStraightLength / 2
  horizontalDistance([topArc.center, ORIGIN]) == slotCenterOffset
  verticalDistance([ORIGIN, topArc.center]) == slotStraightLength / 2
}

slotRegion = region(
  segments = [
    slotSketch.leftEdge,
    slotSketch.bottomArc
  ],
  intersectionIndex = -1,
  direction = CCW,
)
slotSeedCutter = extrude(
  slotRegion,
  length = throughCutDepth,
  symmetric = true,
  method = NEW,
)
slotCutters = patternLinear3d(
  slotSeedCutter,
  instances = 2,
  distance = slotSpacing,
  axis = X,
)
finishedPlate = subtract(plateWithBoltHoles, tools = slotCutters)
hide(slotSketch)
