/*
Generated by Text-to-CAD:
A flat rectangular mounting plate, 110.0mm wide (x-axis) x 42.3mm tall (y-axis) x 1.0mm thick, centered at the origin. It has 4 through-holes, each 3.4mm in diameter, centered at these (x, y) coordinates relative to the plate center: (15.5mm, 15.5mm); (15.5mm, -15.5mm); (-15.5mm, -15.5mm); (-15.5mm, 15.5mm). It also has a 22.0mm diameter through-hole centered on the plate. It also has 2 adjustment slots centered at: (-40.0mm, 0mm) with length 20.0mm along y-axis and width 9.0mm; (40.0mm, 0mm) with length 20.0mm along y-axis and width 9.0mm. All holes and slots go through the full thickness of the plate.
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateWidth = 110mm
plateHeight = 42.3mm
plateThickness = 1mm
mountingHoleDiameter = 3.4mm
mountingHolePitch = 31mm
centerHoleDiameter = 22mm
slotCenterSpacing = 80mm
slotCenterOffset = 40mm
slotLength = 20mm
slotWidth = 9mm
slotRadius = slotWidth / 2
slotStraightLength = slotLength - slotWidth
cutterLength = plateThickness + 2mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -55mm, var -21.15mm], end = [var 55mm, var -21.15mm])
  rightEdge = line(start = [var 55mm, var -21.15mm], end = [var 55mm, var 21.15mm])
  topEdge = line(start = [var 55mm, var 21.15mm], end = [var -55mm, var 21.15mm])
  leftEdge = line(start = [var -55mm, var 21.15mm], end = [var -55mm, var -21.15mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateWidth
  distance([rightEdge.start, rightEdge.end]) == plateHeight
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateHeight / 2
}
plateRegion = region(
  segments = [
    plateSketch.bottomEdge,
    plateSketch.rightEdge
  ],
  intersectionIndex = -1,
  direction = CCW,
)
plateBlank = extrude(plateRegion, length = plateThickness, symmetric = true)
hide(plateSketch)

mountingHoleSketch = sketch(on = XY) {
  mountingCircle = circle(start = [var -13.8mm, var -15.5mm], center = [var -15.5mm, var -15.5mm])

  horizontal([
    mountingCircle.center,
    mountingCircle.start
  ])
  horizontalDistance([mountingCircle.center, ORIGIN]) == mountingHolePitch / 2
  verticalDistance([mountingCircle.center, ORIGIN]) == mountingHolePitch / 2
  diameter(mountingCircle) == mountingHoleDiameter
}
mountingHoleRegion = region(segments = [mountingHoleSketch.mountingCircle])
mountingHoleSeed = extrude(mountingHoleRegion, length = cutterLength, symmetric = true)
mountingHoleRow = patternLinear3d(
  mountingHoleSeed,
  instances = 2,
  distance = mountingHolePitch,
  axis = X,
)
mountingHoleCutters = patternLinear3d(
  mountingHoleRow,
  instances = 2,
  distance = mountingHolePitch,
  axis = Y,
)
plateWithMountingHoles = subtract(plateBlank, tools = mountingHoleCutters)
hide(mountingHoleSketch)

centerHoleSketch = sketch(on = XY) {
  centerCircle = circle(start = [var 11mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([centerCircle.center, ORIGIN])
  horizontal([
    centerCircle.center,
    centerCircle.start
  ])
  diameter(centerCircle) == centerHoleDiameter
}
centerHoleRegion = region(segments = [centerHoleSketch.centerCircle])
centerHoleCutter = extrude(centerHoleRegion, length = cutterLength, symmetric = true)
plateWithAllHoles = subtract(plateWithMountingHoles, tools = [centerHoleCutter])
hide(centerHoleSketch)

slotSketch = sketch(on = XY) {
  rightEdge = line(start = [var -35.5mm, var -5.5mm], end = [var -35.5mm, var 5.5mm])
  topArc = arc(start = [var -35.5mm, var 5.5mm], end = [var -44.5mm, var 5.5mm], center = [var -40mm, var 5.5mm])
  leftEdge = line(start = [var -44.5mm, var 5.5mm], end = [var -44.5mm, var -5.5mm])
  bottomArc = arc(start = [var -44.5mm, var -5.5mm], end = [var -35.5mm, var -5.5mm], center = [var -40mm, var -5.5mm])

  coincident([rightEdge.end, topArc.start])
  coincident([topArc.end, leftEdge.start])
  coincident([leftEdge.end, bottomArc.start])
  coincident([bottomArc.end, rightEdge.start])
  vertical(rightEdge)
  vertical(leftEdge)
  horizontal([
    topArc.start,
    topArc.center,
    topArc.end
  ])
  horizontal([
    bottomArc.start,
    bottomArc.center,
    bottomArc.end
  ])
  tangent([rightEdge, topArc])
  tangent([topArc, leftEdge])
  tangent([leftEdge, bottomArc])
  tangent([bottomArc, rightEdge])
  radius(topArc) == slotRadius
  equalRadius([topArc, bottomArc])
  horizontalDistance([topArc.center, ORIGIN]) == slotCenterOffset
  verticalDistance([ORIGIN, topArc.center]) == slotStraightLength / 2
  horizontalDistance([bottomArc.center, ORIGIN]) == slotCenterOffset
  verticalDistance([bottomArc.center, ORIGIN]) == slotStraightLength / 2
}
slotRegion = region(
  segments = [
    slotSketch.rightEdge,
    slotSketch.topArc
  ],
  intersectionIndex = -1,
  direction = CCW,
)
leftSlotCutter = extrude(slotRegion, length = cutterLength, symmetric = true)
slotCutters = patternLinear3d(
  leftSlotCutter,
  instances = 2,
  distance = slotCenterSpacing,
  axis = X,
)
finishedPlateRaw = subtract(plateWithAllHoles, tools = slotCutters)
hide(slotSketch)

finishedPlate = appearance(
  finishedPlateRaw,
  color = "#aeb8c2",
  metalness = 75,
  roughness = 32,
)
