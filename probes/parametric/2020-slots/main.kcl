/*
Generated by Text-to-CAD:
Define these named parameters at the top of the file, using exactly these names. Where an expression is given, write the expression -- do not replace it with a pre-computed number:

  plateThickness   = 1.0499mm
  plateHeight      = 42.3mm
  boltHoleDia      = 3.4mm
  boltSpacing      = 31mm
  boltHoleOffset   = boltSpacing / 2
  centerHoleDia    = 22mm
  slotSpacing      = 60mm
  slotLength       = 15mm
  slotWidth        = 5.5mm
  edgeMargin       = 10mm
  slotCenterOffset = slotSpacing / 2
  plateWidth       = slotSpacing + 2 * edgeMargin

Then build the part from those parameters, referring to them by name rather than repeating their values:

A flat rectangular mounting plate, plateWidth wide (x-axis) by plateHeight tall (y-axis) by plateThickness thick, centered at the origin.
It has 4 through-holes of boltHoleDia diameter, centered at (-boltHoleOffset, -boltHoleOffset), (boltHoleOffset, -boltHoleOffset), (boltHoleOffset, boltHoleOffset) and (-boltHoleOffset, boltHoleOffset).
It also has a through-hole of centerHoleDia diameter centered on the plate.
It also has 2 adjustment slots cut through the full thickness, each slotLength long along the y-axis and slotWidth wide with semicircular ends, centered at (-slotCenterOffset, 0) and (slotCenterOffset, 0).
All holes and slots go through the full thickness of the plate.
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

plateThickness = 1.0499mm
plateHeight = 42.3mm
boltHoleDia = 3.4mm
boltSpacing = 31mm
boltHoleOffset = boltSpacing / 2
centerHoleDia = 22mm
slotSpacing = 60mm
slotLength = 15mm
slotWidth = 5.5mm
edgeMargin = 10mm
slotCenterOffset = slotSpacing / 2
plateWidth = slotSpacing + 2 * edgeMargin

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -39mm, var -20mm], end = [var 39mm, var -20mm])
  rightEdge = line(start = [var 39mm, var -20mm], end = [var 39mm, var 20mm])
  topEdge = line(start = [var 39mm, var 20mm], end = [var -39mm, var 20mm])
  leftEdge = line(start = [var -39mm, var 20mm], end = [var -39mm, var -20mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateWidth
  distance([rightEdge.start, rightEdge.end]) == plateHeight
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateHeight / 2
}

plateRegion = region(
  segments = [
    plateSketch.bottomEdge,
    plateSketch.rightEdge
  ],
  intersectionIndex = -1,
  direction = CCW,
)
basePlate = extrude(plateRegion, length = plateThickness, symmetric = true)
hiddenPlateSketch = hide(plateSketch)

boltHoleSketch = sketch(on = XY) {
  boltHoleCircle = circle(start = [var -13mm, var -15mm], center = [var -15mm, var -15mm])
  horizontal([
    boltHoleCircle.center,
    boltHoleCircle.start
  ])
  horizontalDistance([boltHoleCircle.center, ORIGIN]) == boltHoleOffset
  verticalDistance([boltHoleCircle.center, ORIGIN]) == boltHoleOffset
  diameter(boltHoleCircle) == boltHoleDia
}

boltHoleRegion = region(segments = [boltHoleSketch.boltHoleCircle])
boltHoleSeed = extrude(
  boltHoleRegion,
  length = plateThickness * 3,
  symmetric = true,
  method = NEW,
)
boltHoleRow = patternLinear3d(
  boltHoleSeed,
  instances = 2,
  distance = boltSpacing,
  axis = X,
)
boltHoleCutters = patternLinear3d(
  boltHoleRow,
  instances = 2,
  distance = boltSpacing,
  axis = Y,
)
plateWithBoltHoles = subtract(basePlate, tools = boltHoleCutters)
hiddenBoltHoleSketch = hide(boltHoleSketch)

centerHoleSketch = sketch(on = XY) {
  centerHoleCircle = circle(start = [var 10mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([centerHoleCircle.center, ORIGIN])
  horizontal([
    centerHoleCircle.center,
    centerHoleCircle.start
  ])
  diameter(centerHoleCircle) == centerHoleDia
}

centerHoleRegion = region(segments = [centerHoleSketch.centerHoleCircle])
centerHoleCutter = extrude(
  centerHoleRegion,
  length = plateThickness * 3,
  symmetric = true,
  method = NEW,
)
plateWithCenterHole = subtract(plateWithBoltHoles, tools = [centerHoleCutter])
hiddenCenterHoleSketch = hide(centerHoleSketch)

adjustmentSlotSketch = sketch(on = XY) {
  rightSide = line(start = [var -27mm, var -5mm], end = [var -27mm, var 5mm])
  topArc = arc(start = [var -27mm, var 5mm], end = [var -33mm, var 5mm], center = [var -30mm, var 5mm])
  leftSide = line(start = [var -33mm, var 5mm], end = [var -33mm, var -5mm])
  bottomArc = arc(start = [var -33mm, var -5mm], end = [var -27mm, var -5mm], center = [var -30mm, var -5mm])

  coincident([rightSide.end, topArc.start])
  coincident([topArc.end, leftSide.start])
  coincident([leftSide.end, bottomArc.start])
  coincident([bottomArc.end, rightSide.start])
  vertical(rightSide)
  parallel([rightSide, leftSide])
  equalLength([rightSide, leftSide])
  equalRadius([topArc, bottomArc])
  tangent([rightSide, topArc])
  tangent([rightSide, bottomArc])
  distance([rightSide.start, rightSide.end]) == slotLength - slotWidth
  radius(topArc) == slotWidth / 2
  horizontalDistance([topArc.center, ORIGIN]) == slotCenterOffset
  verticalDistance([ORIGIN, topArc.center]) == (slotLength - slotWidth) / 2
}

adjustmentSlotRegion = region(
  segments = [
    adjustmentSlotSketch.rightSide,
    adjustmentSlotSketch.topArc
  ],
  intersectionIndex = -1,
  direction = CCW,
)
adjustmentSlotSeed = extrude(
  adjustmentSlotRegion,
  length = plateThickness * 3,
  symmetric = true,
  method = NEW,
)
adjustmentSlotCutters = patternLinear3d(
  adjustmentSlotSeed,
  instances = 2,
  distance = slotSpacing,
  axis = X,
)
finishedPlate = subtract(plateWithCenterHole, tools = adjustmentSlotCutters)
hiddenAdjustmentSlotSketch = hide(adjustmentSlotSketch)

mountingPlate = appearance(
  finishedPlate,
  color = "#B8C1CC",
  metalness = 65,
  roughness = 32,
)
