/*
Generated by Text-to-CAD:
A flat rectangular mounting plate, 80.0mm wide (x-axis) x 42.3mm tall (y-axis) x 1.05mm thick, centered at the origin. It has 4 through-holes, each 3.4mm in diameter, centered at these (x, y) coordinates relative to the plate center: (15.5mm, 15.5mm); (15.5mm, -15.5mm); (-15.5mm, -15.5mm); (-15.5mm, 15.5mm). It also has a 22.0mm diameter through-hole centered on the plate. It also has 2 adjustment slots centered at: (-30.0mm, 0mm) with length 15.0mm along y-axis and width 5.5mm; (30.0mm, 0mm) with length 15.0mm along y-axis and width 5.5mm. All holes and slots go through the full thickness of the plate.
*/
@settings(kclVersion = 2.0, defaultLengthUnit = mm)

plateWidth = 80.0mm
plateHeight = 42.3mm
plateThickness = 1.05mm
mountHoleDiameter = 3.4mm
mountHoleOffset = 15.5mm
centerHoleDiameter = 22.0mm
slotCenterOffset = 30.0mm
slotLength = 15.0mm
slotWidth = 5.5mm
cutLength = plateThickness + 2.0mm

plateSketch = sketch(on = XY) {
  bottomEdge = line(start = [var -40.0mm, var -21.15mm], end = [var 40.0mm, var -21.15mm])
  rightEdge = line(start = [var 40.0mm, var -21.15mm], end = [var 40.0mm, var 21.15mm])
  topEdge = line(start = [var 40.0mm, var 21.15mm], end = [var -40.0mm, var 21.15mm])
  leftEdge = line(start = [var -40.0mm, var 21.15mm], end = [var -40.0mm, var -21.15mm])

  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == plateWidth
  distance([rightEdge.start, rightEdge.end]) == plateHeight
  horizontalDistance([bottomEdge.start, ORIGIN]) == plateWidth / 2
  verticalDistance([bottomEdge.start, ORIGIN]) == plateHeight / 2
}

plateRegion = region(
  segments = [
    plateSketch.bottomEdge,
    plateSketch.rightEdge
  ],
  intersectionIndex = -1,
  direction = CCW,
)
plateBlank = extrude(plateRegion, length = plateThickness, symmetric = true)
hiddenPlateSketch = hide(plateSketch)

mountHoleSketch = sketch(on = XY) {
  mountHoleCircle = circle(start = [var -13.8mm, var -15.5mm], center = [var -15.5mm, var -15.5mm])

  horizontal([
    mountHoleCircle.center,
    mountHoleCircle.start
  ])
  horizontalDistance([mountHoleCircle.center, ORIGIN]) == mountHoleOffset
  verticalDistance([mountHoleCircle.center, ORIGIN]) == mountHoleOffset
  diameter(mountHoleCircle) == mountHoleDiameter
}

mountHoleRegion = region(segments = [mountHoleSketch.mountHoleCircle])
mountHoleSeed = extrude(
  mountHoleRegion,
  length = cutLength,
  symmetric = true,
  method = NEW,
)
mountHoleRow = patternLinear3d(
  mountHoleSeed,
  instances = 2,
  distance = mountHoleOffset * 2,
  axis = X,
)
mountHoleCutters = patternLinear3d(
  mountHoleRow,
  instances = 2,
  distance = mountHoleOffset * 2,
  axis = Y,
)
plateWithMountHoles = subtract(plateBlank, tools = mountHoleCutters)
hiddenMountHoleSketch = hide(mountHoleSketch)

centerHoleSketch = sketch(on = XY) {
  centerHoleCircle = circle(start = [var 11.0mm, var 0.0mm], center = [var 0.0mm, var 0.0mm])

  coincident([centerHoleCircle.center, ORIGIN])
  horizontal([
    centerHoleCircle.center,
    centerHoleCircle.start
  ])
  diameter(centerHoleCircle) == centerHoleDiameter
}

centerHoleRegion = region(segments = [centerHoleSketch.centerHoleCircle])
centerHoleCutter = extrude(
  centerHoleRegion,
  length = cutLength,
  symmetric = true,
  method = NEW,
)
plateWithAllHoles = subtract(plateWithMountHoles, tools = [centerHoleCutter])
hiddenCenterHoleSketch = hide(centerHoleSketch)

slotSketch = sketch(on = XY) {
  slotAxis = line(start = [var -30.0mm, var -4.75mm], end = [var -30.0mm, var 4.75mm], construction = true)
  rightSide = line(start = [var -27.25mm, var -4.75mm], end = [var -27.25mm, var 4.75mm])
  topArc = arc(start = [var -27.25mm, var 4.75mm], end = [var -32.75mm, var 4.75mm], center = [var -30.0mm, var 4.75mm])
  leftSide = line(start = [var -32.75mm, var 4.75mm], end = [var -32.75mm, var -4.75mm])
  bottomArc = arc(start = [var -32.75mm, var -4.75mm], end = [var -27.25mm, var -4.75mm], center = [var -30.0mm, var -4.75mm])

  coincident([rightSide.end, topArc.start])
  coincident([topArc.end, leftSide.start])
  coincident([leftSide.end, bottomArc.start])
  coincident([bottomArc.end, rightSide.start])
  coincident([bottomArc.center, slotAxis.start])
  coincident([topArc.center, slotAxis.end])
  vertical(slotAxis)
  distance([slotAxis.start, slotAxis.end]) == slotLength - slotWidth
  horizontalDistance([slotAxis.start, ORIGIN]) == slotCenterOffset
  verticalDistance([slotAxis.start, ORIGIN]) == (slotLength - slotWidth) / 2
  horizontal([topArc.center, topArc.start])
  horizontal([topArc.center, topArc.end])
  horizontal([bottomArc.center, bottomArc.start])
  horizontal([bottomArc.center, bottomArc.end])
  radius(topArc) == slotWidth / 2
  radius(bottomArc) == slotWidth / 2
}

slotRegion = region(
  segments = [
    slotSketch.rightSide,
    slotSketch.topArc
  ],
  intersectionIndex = -1,
  direction = CCW,
)
slotSeed = extrude(
  slotRegion,
  length = cutLength,
  symmetric = true,
  method = NEW,
)
slotCutters = patternLinear3d(
  slotSeed,
  instances = 2,
  distance = slotCenterOffset * 2,
  axis = X,
)
plateWithSlots = subtract(plateWithAllHoles, tools = slotCutters)
hiddenSlotSketch = hide(slotSketch)

finishedPlate = appearance(
  plateWithSlots,
  color = "#b8bec6",
  metalness = 70,
  roughness = 32,
)
